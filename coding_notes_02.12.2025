> Dirty version of showHBonds:

void FlexibilityView::showHBondSelector()
{
    const auto& hbonds = _controller->handleHBondTicks();
    
    if (hbonds.empty())
    {
        return;
    }
    
    Menu *m = new Menu(this);
    
    // Add each H-bond as a menu option
    for (size_t i = 0; i < hbonds.size(); i++)
    {
        const auto &hbe = hbonds[i];
        std::string label = hbe.Hydrogen->desc() + " → " + hbe.Acceptor->desc();
        std::string tag = "select_hbond_" + std::to_string(i);
        
        auto toggle_this_bond = [this, i, hbe]()
        {
            // Toggle this specific H-bond
            if (_selectedHBondIndices.count(i))
            {
                _selectedHBondIndices.erase(i);
                // Can't unhighlight individual atoms easily here...
            }
            else
            {
                _selectedHBondIndices.insert(i);
                _unit->balls()->highlightAtom(hbe.Hydrogen);
                _unit->balls()->highlightAtom(hbe.Acceptor);
            }
        };
        
        m->addOption(label, toggle_this_bond);
    }
    
    float x, y;
    getFractionalPos(x, y);
    m->setup(x, y);
    setModal(m);
}


